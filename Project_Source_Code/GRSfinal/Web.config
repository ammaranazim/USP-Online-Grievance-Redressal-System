<?xml version="1.0"?>
<configuration>
  <appSettings>
    <add key="ValidationSettings:UnobtrusiveValidationMode"
         value="None" />

    <!-- Gmail SMTP Settings -->
    <add key="SmtpHost" value="smtp.gmail.com" />
    <add key="SmtpPort" value="587" />
    <add key="SmtpEmail" value="your-email@gmail.com" />
    <add key="SmtpAppPassword"
         value="YOUR_GMAIL_APP_PASSWORD" />
    <add key="SmtpEnableSsl" value="true" />
  </appSettings>

  <connectionStrings>
    <add name="GRS"
         connectionString="Data Source=YOUR_SQL_SERVER_NAME;Initial Catalog=GRS;Integrated Security=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <system.web>
    <compilation debug="true" targetFramework="4.5" />
    <httpRuntime targetFramework="4.5" maxRequestLength="8192" />
  </system.web>
</configuration>
